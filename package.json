{
  "name": "astro-caliper",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro integration that shows where a style came from and how far apart elements are, without opening DevTools",
  "license": "MIT",
  "author": "atsekkei",
  "homepage": "https://github.com/atsekkei/astro-caliper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atsekkei/astro-caliper.git"
  },
  "bugs": {
    "url": "https://github.com/atsekkei/astro-caliper/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "css",
    "devtools",
    "inspector",
    "measure",
    "spacing",
    "dx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:boundary": "sh scripts/check-boundary.sh",
    "check": "pnpm run typecheck && pnpm run check:boundary && pnpm run check:core",
    "check:core": "pnpm build && node --test tests/*.test.mjs",
    "check:compat": "pnpm build && node scripts/check-astro-compat.mjs"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "astro": "^5.13.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "launch-editor-middleware": "^2.14.1",
    "postcss": "^8.5.26"
  }
}
